{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "/home/cherr/nixos-config/assets/images/herta.png",
    "width": 30,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "bottom": 0,
      "right": 0
    },
    "printRemaining": true,
    "preserveAspectRatio": true,
    "position": "left"
  },
  "display": {
    "disableLinewrap": true,
    "separator": ""
  },
  "modules": [
    "break",
    "break",
    {
      "key": "{#31} user  {#keys}",
      "type": "title",
      "format": "{user-name}"
    },
    {
      "key": "{#31}󰇅 hname {#keys}",
      "type": "title",
      "format": "{host-name}"
    },
    {
      "key": "{#34}{icon} dist  {#keys}",
      "format": "{3}",
      "type": "os"
    },
    {
      "key": "{#34} ker   {#keys}",
      "type": "kernel"
    },
    {
      "key": "{#34} pkgs  {#keys}",
      "type": "packages",
      "format": "{52} (nix) {49} (flatpak)"
    },
    {
      "key": "{#33}󰇄 wm    {#keys}",
      "type": "wm",
      "format": "{1}"
    },
    {
      "key": "{#33} term  {#keys}",
      "type": "terminal"
    },
    // {
    //   "key": "{#33} sh    {#keys}",
    //   "type": "shell"
    // },
    {
      "key": "{#31}󰍛 cpu   {#keys}",
      "format": "{}",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "{#31}󰉉 disk  {#keys}",
      "format": "{1} / {2} ({3})",
      "type": "disk",
      "folders": "/"
    },
    {
      "key": "{#31} mem   {#keys}",
      "type": "memory"
    },
    {
      "key": "{#37}󰅐 up    {#keys}",
      "type": "uptime"
    },
    "break",
    {
      "type": "custom",
      "key": "   ",
      "format": "{#37}󰮯 {#37} • {#37}• {#37}• {#31} 󰊠 {#32} 󰊠 {#33} 󰊠 {#34} 󰊠 {#35} 󰊠 {#36} 󰊠 "
    }
  ]
}