animations {
  // off
  slowdown 1.1

  workspace-switch {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }

  window-open {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }

  window-close {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }

  horizontal-view-movement {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }

  window-movement {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }

  window-resize {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }

  config-notification-open-close {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }

  exit-confirmation-open-close {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }

  screenshot-ui-open {
    duration-ms 200
    curve "ease-out-quad"
  }

  overview-open-close {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }

  recent-windows-close {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.00001
  }
}